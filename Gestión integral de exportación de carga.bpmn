    <task id="Id_8ea39b0f-ec79-4f1f-a35a-50afea7e5896" name="Validar documentación del manifiesto de carga">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;a name="_dx_frag_EndFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Verificar que la documentaci&amp;oacute;n del manifiesto est&amp;eacute; completa, correcta y corresponda a la carga recibida, as&amp;iacute; como que los documentos est&amp;eacute;n organizados seg&amp;uacute;n el orden establecido.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_e22b3d0c-b5df-49b2-bcda-53100b7ae0ff</incoming>
      <outgoing>Id_d7589846-52bf-406e-952b-46ecb1f418b6</outgoing>
    </task>
    <task id="Id_25a752b3-25d0-4585-9358-88c459da9505" name="Preparar carga para exportación ">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Es la fase operativa cr&amp;iacute;tica donde la carga, habiendo superado satisfactoriamente la validaci&amp;oacute;n documental, es organizada, consolidada y acondicionada f&amp;iacute;sicamente para cumplir con los est&amp;aacute;ndares de seguridad y log&amp;iacute;stica requeridos para el transporte internacional.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_83a3ddda-367f-4172-9d4b-d221f63e0df5</incoming>
      <incoming>Id_fcf278e1-6cca-4d0e-93b7-7f05209c1f26</incoming>

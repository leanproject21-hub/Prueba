      </ioSpecification>
      <dataInputAssociation id="Id_0eda3c3a-9042-41ec-82d4-78ffb2843628">
        <sourceRef>Id_c382d85a-3afd-4852-a58a-c6aaf8a35f8a</sourceRef>
        <targetRef>Id_87f9f6ef-222f-47cb-86a7-0391aa72c152</targetRef>
      </dataInputAssociation>
    </receiveTask>

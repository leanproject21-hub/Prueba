    <task id="Id_40deedc1-1c91-45f3-ac2d-47a01fdf5634" name="Programar para la siguiente exportación">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Es la acci&amp;oacute;n administrativa y operativa ejecutada por el Supervisor de Outbound para reasignar aquellos env&amp;iacute;os que, por incidencias documentales, falta de permisos o recepci&amp;oacute;n fuera de la ventana de tiempo establecida, no pudieron ser integrados en el manifiesto de exportaci&amp;oacute;n del d&amp;iacute;a en curso.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />

    <task id="Id_43f685a7-19f4-40af-9511-5411d1337a4a" name="Elaborar guías draft para pre-alerta">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;a name="_dx_frag_EndFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;El Supervisor de Outbound debe utilizar la conciliaci&amp;oacute;n del detalle de carga por consolidado para completar el archivo Excel de las gu&amp;iacute;as draft. Debe trasladar la informaci&amp;oacute;n correspondiente a cada estaci&amp;oacute;n de destino, incluyendo las cantidades de paquetes, la distribuci&amp;oacute;n por sacos y piezas sueltas, los pesos y los dem&amp;aacute;s datos requeridos. Una vez completadas, debe verificar que las gu&amp;iacute;as draft coincidan con la informaci&amp;oacute;n conciliada antes de enviarlas como prealerta a las estaciones de destino.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="Black" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_95ec8b04-ed34-457c-8ee8-539f1a826a80</incoming>
      <outgoing>Id_ed87b947-57f8-4ac3-9f46-f96dc17ac38a</outgoing>

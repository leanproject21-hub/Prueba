    <intermediateThrowEvent id="Id_aed2b87a-4c3f-40d2-aee9-6b8762193b09" name="Correo matutino Pre-alerta de Carga enviado">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;El evento se genera cuando el Supervisor de Outbound env&amp;iacute;a el correo matutino de prealerta a las estaciones correspondientes, informando sobre la carga prevista para exportaci&amp;oacute;n. Esta comunicaci&amp;oacute;n permite anticipar la recepci&amp;oacute;n de los env&amp;iacute;os y facilitar la planificaci&amp;oacute;n operativa de las estaciones de destino.&lt;/span&gt;&lt;a name="_dx_frag_EndFragment"&gt;&lt;/a&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:-18pt;margin:0pt 0pt 0pt 36pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Symbol;font-size:11pt;font-weight:normal;font-style:normal;"&gt;&amp;middot; &lt;/span&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Memphis&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:-18pt;margin:0pt 0pt 0pt 36pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Symbol;font-size:11pt;font-weight:normal;font-style:normal;"&gt;&amp;middot; &lt;/span&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;SJO&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FEFAEF" />
            <bizagi:BizagiProperty name="borderColor" value="#969149" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />

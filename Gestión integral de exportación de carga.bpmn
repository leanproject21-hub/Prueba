    <task id="Id_719f650e-9633-493e-bbd4-1b221d4b8f09" name="Registrar paquetes bajo la etiqueta CONS en Leopad">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Escanear la etiqueta CONS en Leopad y registrar individualmente los paquetes que pertenecen al consolidado correspondiente.&lt;/span&gt;&lt;a name="_dx_frag_EndFragment"&gt;&lt;/a&gt;&lt;/p&gt;</documentation>

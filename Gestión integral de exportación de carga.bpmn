    <task id="Id_015e57da-f17c-40d0-8baa-977002b73f44" name="Aplicar estatus SOPS en Leopad">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Una vez que la carga haya completado satisfactoriamente las auditor&amp;iacute;as internas y est&amp;eacute; habilitada para su despacho, el courier asignado debe aplicar el estatus SOPS en Leopad a cada paquete de exportaci&amp;oacute;n conforme se prepara para cargarlo en el VAN. El escaneo se realiza en estaci&amp;oacute;n, antes de colocar los paquetes dentro del veh&amp;iacute;culo, debido a que el acceso a las gu&amp;iacute;as se dificulta una vez que la carga est&amp;aacute; acomodada.&lt;/span&gt;&lt;a name="_dx_frag_EndFragment"&gt;&lt;/a&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="Black" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_981c3726-3408-4325-9ac3-aa56a9eb9250</incoming>
      <outgoing>Id_f5bfc8fc-0e89-45d4-b47d-bc2bba62c8c1</outgoing>
    </task>

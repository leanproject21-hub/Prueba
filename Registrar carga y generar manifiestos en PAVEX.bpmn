          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <outgoing>Id_2e32f285-1779-445a-bcb7-93c6ed6339d6</outgoing>
    </startEvent>
    <task id="Id_d0a28b93-094d-4863-8e6c-cd506fc239e1" name="Escanear guía y registrar documentación en PAVEX">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;a name="_dx_frag_EndFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;El usuario debe escanear el n&amp;uacute;mero de gu&amp;iacute;a o label de la gu&amp;iacute;a utilizando el esc&amp;aacute;ner PAVEX. Luego, debe registrar en el sistema la documentaci&amp;oacute;n complementaria requerida, que incluye los permisos correspondientes, las facturas en espa&amp;ntilde;ol y la lista de empaque. En cada caso, se debe validar si el documento aplica o no, seg&amp;uacute;n el tipo de mercanc&amp;iacute;a.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_2e32f285-1779-445a-bcb7-93c6ed6339d6</incoming>
      <outgoing>Id_a5e15128-b16f-4e8c-8d36-db921689e30e</outgoing>
    </task>
    <task id="Id_e5afcad3-2545-48b6-9db3-76113af69f25" name="Crear consolidado de exportación en PAVEX">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;a name="_dx_frag_EndFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Ingresar al m&amp;oacute;dulo de gesti&amp;oacute;n de carga en PAVEX y seleccionar la opci&amp;oacute;n &amp;laquo;Nuevo Consolidado&amp;raquo;. Escanear &amp;uacute;nicamente la etiqueta CONS (DOCTOS)&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_a5e15128-b16f-4e8c-8d36-db921689e30e</incoming>
      <outgoing>Id_b271bffc-fbcd-435c-bb15-e48f0329d721</outgoing>
    </task>
    <task id="Id_39c2f8a6-8baa-490d-8e93-3ab642125ba3" name="Asignar guías al consolidado en PAVEX">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Vincular las gu&amp;iacute;as f&amp;iacute;sicas al consolidado previamente creado en el sistema, asignando &amp;uacute;nicamente aquellas correspondientes a env&amp;iacute;os de documentos y asegurando que no se incluyan otros tipos de carga&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_b271bffc-fbcd-435c-bb15-e48f0329d721</incoming>
      <outgoing>Id_438c51bf-4367-444f-838b-3c3b79624949</outgoing>
    </task>
    <task id="Id_19a11769-11ff-4ce1-8a02-9d0ad0627b3d" name="Crear manifiesto de exportación en PAVEX">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_99f7788c-adcf-4797-98ce-75f46dd22316</incoming>
      <outgoing>Id_497ce429-e67f-4125-b027-4676a363f7a9</outgoing>
    </task>
    <task id="Id_59d64a42-c756-480a-a4d5-676d9dbc3291" name="Distribuir las guías en PAVEX por manifiesto">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Asignar las gu&amp;iacute;as a sus respectivos manifiestos de exportaci&amp;oacute;n, considerando la capacidad de los pallets y la distribuci&amp;oacute;n equilibrada del peso. Verificar la correcta vinculaci&amp;oacute;n de cada gu&amp;iacute;a con su manifiesto.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_497ce429-e67f-4125-b027-4676a363f7a9</incoming>
      <outgoing>Id_7afb2f38-a75d-4b19-bdd1-8681ba91e5be</outgoing>
    </task>
    <endEvent id="Id_5207c63f-7b59-4c58-826d-5ba31cd4a964" name="Carga y documentación registradas en PAVEX">

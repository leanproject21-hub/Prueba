  <process id="Id_bf32167e-5cf2-44e6-8f22-defa514c7b70" name="Registrar carga y generar manifiestos en PAVEX">
    <documentation />
    <laneSet id="Id_2fe6cbe4-4853-4b7b-84be-256bcfb72195">
      <lane id="Id_95b2b882-4d74-4c42-9dc1-0187e3802254" name="Supervisor de Outbound">
        <documentation />
        <childLaneSet id="Id_f5096332-f189-4400-a6ce-712ef773ccb5" />
      </lane>
    </laneSet>
    <startEvent id="Id_8ad96f86-fd91-4484-a3d0-71351ef2e796" name="Consolidado en Leopad cerrado">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E6FF97" />
            <bizagi:BizagiProperty name="borderColor" value="#62A716" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />

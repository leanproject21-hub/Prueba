    </startEvent>
    <task id="Id_eca04da5-d74c-40b9-902a-05a01c8713ca" name="Identificar incidencia documental de carga">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;a name="_dx_frag_EndFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Revisar la documentaci&amp;oacute;n del manifiesto recibido para identificar las incidencias que requieren resoluci&amp;oacute;n y determinar si pueden ser gestionadas en la estaci&amp;oacute;n.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_ee9c09d8-d571-43af-8435-76207bc05daa</incoming>
      <outgoing>Id_5f05b24b-6c53-4bcc-9b8b-34890453ffb5</outgoing>
    </task>
    <exclusiveGateway id="Id_18b13f9e-4547-4d7d-bc44-8d096e2ad2e6" name="¿Puede gestionarse en estación?" gatewayDirection="Diverging">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFCC" />
            <bizagi:BizagiProperty name="borderColor" value="#A6A61D" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_5f05b24b-6c53-4bcc-9b8b-34890453ffb5</incoming>
      <outgoing>Id_a40d14de-000a-4f9b-ae15-3c9824f0791b</outgoing>
      <outgoing>Id_cf088b1f-50da-48fc-bd38-d47a5883526a</outgoing>
    </exclusiveGateway>
    <task id="Id_d593c3dc-c5ee-46ea-aceb-0d91b6f6ee93" name="Completar o corregir documentación">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Completar los documentos faltantes o corregir la informaci&amp;oacute;n identificada en la estaci&amp;oacute;n, de acuerdo con el tipo de incidencia. Entre los casos a considerar se incluyen: la impresi&amp;oacute;n de una gu&amp;iacute;a faltante, la preparaci&amp;oacute;n de la factura en ingl&amp;eacute;s, la gesti&amp;oacute;n del permiso DFA y la correcci&amp;oacute;n de una gu&amp;iacute;a, la cual deber&amp;aacute; ser gestionada por el agente de servicio en el counter.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_a40d14de-000a-4f9b-ae15-3c9824f0791b</incoming>
      <outgoing>Id_36b15e3d-a344-4e99-8e93-ba4a228f5e49</outgoing>
    </task>
    <sendTask id="Id_66a50104-9e28-49cc-9bf8-510d7127c81c" name="Solicitar documentación al cliente">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Contactar al cliente para solicitar la documentaci&amp;oacute;n faltante o corregida que no se pueda gestionar en la estaci&amp;oacute;n. Especificar claramente qu&amp;eacute; documentos se necesitan y hacer seguimiento hasta su recepci&amp;oacute;n.&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_cf088b1f-50da-48fc-bd38-d47a5883526a</incoming>
      <outgoing>Id_539470df-29c8-4579-b82d-c04b6796a7be</outgoing>
    </sendTask>

    <task id="Id_86816682-d6f9-490c-a7ca-64d28e0ff33b" name="Verificar que la carga conectó en destino">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Consultar el CONS Report el d&amp;iacute;a siguiente a la exportaci&amp;oacute;n para verificar que la carga haya conectado en el destino correspondiente. Identificar los consolidados o env&amp;iacute;os que no reflejen la conexi&amp;oacute;n esperada y determinar si requieren seguimiento&lt;/span&gt;&lt;a name="_dx_frag_EndFragment"&gt;&lt;/a&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="Black" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_a5662489-55fc-471e-8e2b-1b88847bfd97</incoming>
      <outgoing>Id_3e627e1b-c769-4a68-bc2c-ed3c65d03a6d</outgoing>
    </task>
    <task id="Id_6a639d14-d36b-49fc-a2cb-abd43138dbdf" name="Validar estatus aplicados por los países receptores">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Revisar en el CONS Report los estatus registrados por los pa&amp;iacute;ses receptores para comprobar que la carga exportada cuente con las actualizaciones correspondientes. Identificar env&amp;iacute;os con estatus faltantes o inconsistentes para gestionar su seguimiento.&lt;/span&gt;&lt;a name="_dx_frag_EndFragment"&gt;&lt;/a&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="Black" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_3e627e1b-c769-4a68-bc2c-ed3c65d03a6d</incoming>
      <outgoing>Id_ae3c465d-b2e4-440b-a9f2-5afb5d07c95d</outgoing>
    </task>
    <sequenceFlow id="Id_3e627e1b-c769-4a68-bc2c-ed3c65d03a6d" sourceRef="Id_86816682-d6f9-490c-a7ca-64d28e0ff33b" targetRef="Id_6a639d14-d36b-49fc-a2cb-abd43138dbdf">
      <extensionElements>

      <outgoing>Id_59a9433c-ec38-4abf-8c0b-ce53509d64b1</outgoing>
    </task>
    <task id="Id_f805e148-b496-47d7-8122-9a5a43445ee4" name="Aplicar estatus Pux 23 + Stat 44 con Leopad">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;a name="_dx_frag_EndFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Registrar en Leopad los estados PUX 23 y STAT 44 para los env&amp;iacute;os que permanecer&amp;aacute;n temporalmente en estaci&amp;oacute;n, permitiendo su trazabilidad, informando su ubicaci&amp;oacute;n actual y programando su despacho en el siguiente corte operativo o d&amp;iacute;a h&amp;aacute;bil correspondiente.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_6cf65353-50b6-4ac6-a4c2-f6b8c111d5dd</incoming>
      <outgoing>Id_6f07d45f-d139-4006-ae51-e6fcf78571ba</outgoing>
    </task>
    <task id="Id_535cd5bb-fe89-45fb-84f0-9ed1f234f5ab" name="Aplicar estatus PUP con Leopad">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Registrar el estatus PUP en Leopad para los env&amp;iacute;os recepcionados antes de la hora de corte, indicando que la carga ha sido procesada y se encuentra programada para su despacho el mismo d&amp;iacute;a.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_3fe39176-2600-4f6a-998d-9dd001a3b5e4</incoming>
      <outgoing>Id_6bf43346-e56c-4e4d-82f5-9c0fa4d98223</outgoing>
    </task>

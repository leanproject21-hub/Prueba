    <manualTask id="Id_2b362836-a66d-44d6-ba49-ce919edd78d0" name="Trasladar carga y manifiesto al área de Outbound">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;a name="_dx_frag_EndFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Consolidar y trasladar la carga documentada junto con el manifiesto de exportaci&amp;oacute;n al &amp;aacute;rea de Outbound mediante el uso de carretilla, optimizando la movilizaci&amp;oacute;n de los env&amp;iacute;os y reduciendo traslados individuales durante la jornada.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>

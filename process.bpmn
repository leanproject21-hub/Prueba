      <outgoing>Id_bb0f484f-5667-4d41-94de-0a64dd2e5f10</outgoing>
    </task>
    <task id="Id_506599b8-6ed2-4afa-a8e0-d36e762969fb" name="Definir fecha de despacho del envío">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Determinar si el env&amp;iacute;o se despacha el mismo d&amp;iacute;a o se programa para el siguiente, evaluando si la hora de recepci&amp;oacute;n es previa a la hora de corte de exportaci&amp;oacute;n (10:00 a. m.).&lt;/span&gt;&lt;a name="_dx_frag_EndFragment"&gt;&lt;/a&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_a147de63-00a0-4681-966f-f097ea268616</incoming>
      <outgoing>Id_5391fbfa-3c28-470c-8ee9-61a21362fd74</outgoing>
    </task>
    <task id="Id_49958fb6-067e-4b7c-a4bd-181e7b710d1d" name="Adjuntar documentación al paquete">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Adjuntar la gu&amp;iacute;a a&amp;eacute;rea, facturas y permisos f&amp;iacute;sicos dentro del bolsillo protector (pouch) adherido al paquete.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">

    <task id="Id_02ca1210-efb7-4064-98b6-a6330228dc2b" name="Consolidar carga pendiente en Pickup Manifest">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;a name="_dx_frag_EndFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Registrar y consolidar en el Pickup Manifest los env&amp;iacute;os resguardados en estaci&amp;oacute;n que ser&amp;aacute;n enviados en la exportaci&amp;oacute;n del d&amp;iacute;a siguiente, garantizando el control, la trazabilidad y la identificaci&amp;oacute;n de la carga pendiente de despacho. &lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
